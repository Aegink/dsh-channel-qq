# dsh-channel-qq 部署凭据模板
#
# 用法：复制成 deploy/.ssh-env 并填真实值。`.ssh-env` 已被 .gitignore 排除。
#     cp deploy/.ssh-env.example deploy/.ssh-env
#
# 也可以不用文件，直接设环境变量（脚本里环境变量优先，文件只补未设置的项）。

# ── SSH（deploy/ssh-run.mjs 与 deploy/http-push-fast.mjs 都要）──────────────
# 注意端口不是 22。
DSH_SSH_HOST=YOUR_HOST
DSH_SSH_PORT=22
DSH_SSH_USER=root
DSH_SSH_PASSWORD=

# ── 管理后台密码（P0 起后台只监听 127.0.0.1，从开发机直连 8790 已不可用）──────
# 只有 deploy/admin-test.mjs（在服务器上跑）用得到，值从 /etc/dsh/env 的
# CHANNEL_QQ_ADMIN_PASSWORD 抄；不填则脚本去读 ~/.dsh-channel-qq-admin-password。
# DSH_ADMIN_PASSWORD=
# DSH_ADMIN_BASE=http://127.0.0.1:8790
DSH_ADMIN_WORKSPACE=/path/to/workspace

# ── dsh 自带的 ssh-mcp-server（http-push-fast.mjs 用它跑远程命令）────────────
# 换机器/换安装位置时改这里。留空则用脚本内默认路径。
# DSH_MCP_SERVER=G:/dev-cache/mcp/ssh-mcp-server/node_modules/@fangjunjie/ssh-mcp-server/build/index.js