# ── 依赖 ──────────────────────────────────────────────────────────────
node_modules/

# ── 含真实凭据的一次性探测脚本（绝不入库）─────────────────────────────
# napcat-alive.mjs      硬编码 OneBot accessToken（已过期）与旧群号
# groq-browser-probe.mjs 硬编码 Groq API key (gsk_…)
# 这两个都是临时排障脚本，不属于插件本体。文件仍留在工作目录里。
napcat-alive.mjs
groq-browser-probe.mjs

# ── 编辑器 / 系统 ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.log

# ── 说明：以下**故意入库** ────────────────────────────────────────────
# lib/                 编译产物。本项目的部署方式是"推送预编译 lib/"，入库
#                      可保证 clone 出来的目录直接可部署。
# src/admin-html.ts    由 src/admin-ui.html 生成（scripts/build-admin-html.mjs），
#                      入库是为了 tsc 单独跑也能通过；改它没有意义，改 HTML。
# cordis.patch.yml     插件的 bundle 默认值（不含任何部署凭据）。

# ── 临时：NapCat 登录扫码页 ───────────────────────────────────────────
# 容器重建后需要重新扫码时由脚本生成（内嵌当次二维码的 base64），一次性用完即弃，
# 不属于项目产物。
_qr-login.html

# ── 构建产物：不入库 ──────────────────────────────────────────────────
# 部署方式是「推 src/ → 在服务器上 `npm run build`（= build:admin + tsc）生成 lib/」，
# 所以 lib/ 永远可以在目标机上重建，不需要进仓库。
#
# 2026-10-15 把 lib/ 移出版本管理的原因：它入库后会**悄悄和 src/ 漂移**。
# 当时本地 lib/tools.js 与服务端 lib/tools.js 的 sha256 不同
# （sha256 差异来自模板字符串里的 2 个 CR——本地产物是早先 CRLF 时代的旧副本），
# 于是「本地的 lib 到底是不是线上跑的那份」这个问题没有答案、只能靠猜。
# 产物不入库，这个问题就不存在了。
#
# ⚠️ 必须是 `/lib/`（锚定仓库根）：写成 `lib/` 会连**任意层级**的 lib 目录一起吞掉，
# 包括 `eval/lib/`——评测底盘的支持模块住在那儿，于是 `git add eval` 静默跳过它，
# 干净检出里 `npm run eval` 直接 ERR_MODULE_NOT_FOUND（在 git worktree 里试做发布
# 构建时才发现：本地一直有文件，所以从没暴露）。
/lib/

# ── 测试产物：不入库 ────────────────────────────────────────────────
# npm test 把 src/ 与 test/ 一起编译到这里再用 node --test 跑。
lib-test/

# ── 推送中转：不入库 ────────────────────────────────────────────────
# 走 SSH 通道推文件时的本地暂存目录。
.push-tmp/

# ── 部署凭据：绝不入库 ────────────────────────────────────────────────
# deploy/http-push-fast.mjs 与 deploy/ssh-run.mjs 从这里读服务器地址与密码。
# 模板见 deploy/.ssh-env.example
.ssh-env
# 部署中转（打包产物，不入库）
.deploy-tmp/

# ── 发布产物与清单（每次打包重新生成）────────────────────────────────
MANIFEST.sha256
RELEASE.json

# 评测器每次运行的产物（用例在 eval/ 里，报告不入库）
eval/last-report.json

# ── 记忆评测的真实语料缓存（含私人聊天内容，绝不入库）──────────────
eval/memory/.cache/

# 本地调研缓存（GitHub / Docker Hub 快照等）
.cache/
